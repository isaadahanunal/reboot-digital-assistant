# Copy to .env and fill in. .env is git-ignored and read at server start.
# A real exported environment variable always wins over this file.

# --- Coach engine ---------------------------------------------------------
# gemini (default) | anthropic | offline
REBOOT_PROVIDER=gemini

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional secondary provider
# ANTHROPIC_API_KEY=

# --- Optional overrides ---------------------------------------------------
# Google retires models on its own schedule. If generation 404s, run
#   python3 tools/list_models.py
# and pin a model your key can actually call:
# REBOOT_GEMINI_MODEL=gemini-3.6-flash
#
# Gemini 3 thinking depth: "low" (default, ~6s) or "high" (slower, more reasoning).
# The digest prompt already spells out its reasoning steps, so low loses nothing here.
# REBOOT_GEMINI_THINKING=low
# REBOOT_ANTHROPIC_MODEL=claude-opus-5
# REBOOT_DATA_DIR=./data
